  "procedures": [
    {
      "TRIM": "SYNC_PROFILE_GET_DEFAULT",
      "RDB$PROCEDURE_SOURCE": "begin\r\n  error_code = 0;\r\n  error_text = '';\r\n  check_code = 0;\r\n  check_text = '';\r\n\r\n  if ((recid is null) and (rectype is null)) then\r\n    for with protocol_list as\r\n      (\r\n        select distinct protocolid\r\n        from treatplacesigndet tsd\r\n        left join treatplacesign ts on ts.tpsignid = tsd.tpsignid\r\n        left join dicinfo d on d.dicid = tsd.recid and refid = -508 and d.rekvint1 in (2,5,7,14)\r\n        where tsd.rectype = 97\r\n        and tsd.modifydate > current_date - 30\r\n        and ts.tpsignid > 0 and d.dicid > 0\r\n      )\r\n      , placeid_list as\r\n      (\r\n        select distinct placeid\r\n        from protocol_list p\r\n        left join treatplace tp on tp.protocolid = p.protocolid\r\n      )\r\n      , refid_list as\r\n      (\r\n        select distinct gp.reftodict refid\r\n        from placeid_list p\r\n        left join workplacedoclinks wpl on p.placeid = wpl.placeid\r\n        left join groupsdictlinks gdl on wpl.groupid = gdl.groupid\r\n        left join groupsparams gp on gdl.codeparams = gp.codeparams\r\n        where reftodict is not null\r\n      )\r\n\r\n      select distinct syncrefid\r\n        from refid_list rl\r\n        left join refdic r on rl.refid = r.refid\r\n        left join sync_reference sr on ((r.refid = sr.dicrefid) or (r.refcode = sr.refcode))\r\n        where r.refid is not null and sr.syncrefid > 0\r\n      into :SYNCREFID do suspend;\r\n  else if ((coalesce(:recid, 0) > 0) and (:rectype = 97)) then\r\n    for with placeid_list as\r\n      (\r\n        select distinct wd.placeid\r\n        from workplacedocdet wpd\r\n        left join workplacedoc wd on wpd.placeid = wd.placeid\r\n        where wpd.rectype = 97 and (wpd.recid = cast(:recid as tbigcode) or cast(:recid as tbigcode) is null)\r\n      )\r\n      , refid_list as\r\n      (\r\n        select distinct gp.reftodict refid\r\n        from placeid_list p\r\n        left join workplacedoclinks wpl on p.placeid = wpl.placeid\r\n        left join groupsdictlinks gdl on wpl.groupid = gdl.groupid\r\n        left join groupsparams gp on gdl.codeparams = gp.codeparams\r\n        where reftodict is not null\r\n      )\r\n\r\n      select distinct syncrefid\r\n        from refid_list rl\r\n        left join refdic r on rl.refid = r.refid\r\n        left join sync_reference sr on ((r.refid = sr.dicrefid) or (r.refcode = sr.refcode))\r\n      where r.refid is not null and sr.syncrefid > 0\r\n    into :SYNCREFID do suspend;\r\nend"
    }
  ],
